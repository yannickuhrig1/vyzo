<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Toujours facultatif : tous les Fire TV ne déclarent pas leanback. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Android 11+ : sans cette déclaration, le fournisseur des rangées d'accueil reste invisible pour l'appli. -->
    <queries>
        <provider android:authorities="android.media.tv" />
    </queries>

    <application>
        <!-- LEANBACK_LAUNCHER pour Android TV et Google TV, LAUNCHER pour Fire TV. -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
